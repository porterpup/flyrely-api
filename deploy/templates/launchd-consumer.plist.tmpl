<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>swim.consumer</string>
        <string>--source</string>
        <string>__SOURCE__</string>
        <string>--log-file</string>
        <string>__LOG_DIR__/swim-__SOURCE__.log</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>FLYRELY_ENV_FILE</key>
        <string>__ENV_FILE__</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Plain KeepAlive: restart whenever the process dies. The consumer never exits on its own for an
         authentication failure or a configuration error: it parks IN-PROCESS (status "parked" /
         "config_error", no connection attempts) and waits, so there is nothing to respawn. It does exit 4 (safety net: 2 consecutive
         TLS errors, 30 consecutive connect failures, or too many open file descriptors) so this
         KeepAlive brings it back as a clean process. Background: on 2026-11-13 the trust-store folder
         lived in $TMPDIR and macOS temp cleanup emptied it, so every reconnect failed with "untrusted
         certificate" until a restart. The folder is now data/swim/trust/ and is rebuilt if empty. -->
    <key>KeepAlive</key>
    <true/>
    <!-- at most one (re)start per minute. This alone does not stop a restart loop: the consumer itself
         rate-limits its TLS fast-exit (once per 30 min), and swim.health alerts on tls_error/restarting
         states, on 3+ restarts per hour, and on silence (which is carried across restarts). -->
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/swim-__SOURCE__.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/swim-__SOURCE__.stderr.log</string>
__DAEMON_KEYS__</dict>
</plist>
