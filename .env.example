# FlyRely API Configuration
# Copy this to .env and fill in your values

# Weather API Configuration
# Option 1: Tomorrow.io (recommended for aviation)
# Get API key at: https://www.tomorrow.io/weather-api/
WEATHER_API_PROVIDER=tomorrow
WEATHER_API_KEY=your_tomorrow_io_api_key_here

# Option 2: OpenWeatherMap
# Get API key at: https://openweathermap.org/api
# WEATHER_API_PROVIDER=openweathermap
# WEATHER_API_KEY=your_openweathermap_api_key_here

# Server Configuration (optional)
# HOST=0.0.0.0
# PORT=8000

# Deployed frontend origins allowed by CORS (comma-separated).
# localhost:3000 / localhost:5173 are always allowed for development.
# FLYRELY_ALLOWED_ORIGINS=https://your-frontend.example

# Prediction log: every successful /predict is stored for later outcome matching.
# SQLite file used when DATABASE_URL is not set (created if missing).
# FLYRELY_PREDICTION_DB=./data/predictions.sqlite
# Postgres connection string (e.g. Supabase). When set, it replaces SQLite.
# Create the table first by running migrations/001_predictions.sql.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
